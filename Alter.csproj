<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>assets\Alter.ico</ApplicationIcon>

    <!-- Assembly metadata (SupportedOSPlatform is generated from the -windows TFM) -->
    <AssemblyTitle>Alter</AssemblyTitle>
    <Product>Alter Trainer Hub</Product>
    <Description>Local Windows trainer creator and library</Description>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <InformationalVersion>v0.2.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Keep the existing code compiling as written -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 
      Alter loads these from the folder next to Alter.exe 
      TODO: move these to an installation folder to fetch from.
    -->
    <None Include="assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="community\**" Exclude="community\*cache.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
